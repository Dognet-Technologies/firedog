# FireDog Cron Jobs — installed at /etc/cron.d/firedog (symlink)
#
# Tutti i job girano come `microcyber` con NOPASSWD sudo dove serve.
# Output di firewall-manager / iptables vanno in /opt/sentinelsuite/firedog/{data,export,rules}.
# Il dog-agent legge periodicamente export/status.json e lo invia al server.

# ========== STATUS EXPORT (fonte principale per il server) ==========
# Snapshot completo firewall+system in JSON ogni 5 minuti.
# Sovrascrive lo stesso file: l'agent lo legge e lo invia via WS.
*/5 * * * * microcyber sudo /usr/local/bin/firewall-manager --export-json /opt/sentinelsuite/firedog/export/status.json 2>&1 | logger -t firedog-export

# ========== IPTABLES BACKUP ==========
# Backup giornaliero alle 3:00.
0 3 * * * microcyber sudo /usr/sbin/iptables-save > /opt/sentinelsuite/firedog/rules/iptables.backup-$(date +\%Y\%m\%d).rules 2>/dev/null

# ========== LOG ROTATION ==========
# Pulizia file vecchi.
0 2 * * * microcyber find /opt/sentinelsuite/firedog/data  -name "*.json"          -mtime +7  -delete 2>/dev/null
0 2 * * * microcyber find /opt/sentinelsuite/firedog/logs  -name "*.log"           -mtime +7  -delete 2>/dev/null
0 3 * * * microcyber find /opt/sentinelsuite/firedog/rules -name "iptables.backup-*.rules" -mtime +30 -delete 2>/dev/null

# ========== HEALTH CHECK ==========
# Stato del firewall service ogni ora (al log file locale).
0 * * * * microcyber sudo systemctl is-active firewall-fm > /opt/sentinelsuite/firedog/logs/health-check.log 2>&1
