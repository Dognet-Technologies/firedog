# FireDog — configurazione locale del target
# Installato a /etc/firewall/firedog.conf (seed al primo install, come
# custom_rules.conf — non viene mai sovrascritto agli aggiornamenti).
#
# Formato: KEY="value" — sourceable direttamente da bash (firewall-init.sh)
# e parsato riga per riga da firewall-manager.py. Righe vuote o che
# iniziano con # sono ignorate.

# ── Interfacce da monitorare ─────────────────────────────────────────────
# Lista separata da virgole dei nomi NIC (es. "eth0,eth1") che
# firewall-manager --export-json deve riportare al server. Vuoto = tutte
# le interfacce rilevate (comportamento di default). Utile per escludere
# interfacce virtuali/interne rumorose (docker0, veth*, tailscale0...) che
# non interessa gestire da FireDog.
MONITORED_INTERFACES=""

# ── Porte da tenere sempre aperte ────────────────────────────────────────
# Lista separata da virgole di porta/protocollo (es. "80/tcp,443/tcp,53/udp")
# accettate in INPUT su tutte le interfacce PRIMA che la policy DROP finale
# di firewall-init.sh entri in vigore. La porta SSH è già protetta a parte
# (rilevata automaticamente / SSH_PORT), non serve elencarla qui a meno di
# usare porte SSH aggiuntive.
#
# Impostare PRIMA di lanciare firewall-init.sh la prima volta: senza,
# qualunque servizio in ascolto su queste porte diventerebbe irraggiungibile
# non appena la policy DROP viene applicata.
ALWAYS_OPEN_PORTS=""

# ── Sorgenti SSH sempre fidate ───────────────────────────────────────────
# Lista separata da virgole di IP/CIDR (es. "10.10.0.0/24,203.0.113.5") per
# cui SSH bypassa interamente la protezione brute-force (SSH_PROTECT): niente
# rate limit, niente ban, nessuna dipendenza dalle soglie sotto. Pensato per
# la propria rete di management/bastion (VPN, jump host) — NON un modo per
# aprire SSH al pubblico: le sorgenti qui restano protette solo da
# autenticazione SSH stessa.
#
# Nota: ALWAYS_OPEN_PORTS non basta per SSH perché la porta SSH viene
# intercettata da SSH_PROTECT prima che qualunque regola ALWAYS_OPEN_PORTS
# venga valutata — per questo esiste questa lista separata.
#
# Vuoto di default: nessun cambiamento al comportamento storico.
TRUSTED_SSH_SOURCES=""

# ── Protezione SSH brute-force ───────────────────────────────────────────
# Soglia: quanti nuovi tentativi di connessione SSH in che finestra di
# tempo (secondi) fanno scattare la protezione. Default alzati (era 4/60s)
# perché una soglia troppo bassa droppa anche sessioni SSH legittime
# ravvicinate (es. tool di amministrazione/debug che riconnettono spesso).
SSH_PROTECT_MAX_ATTEMPTS="20"
SSH_PROTECT_WINDOW_SECONDS="60"

# Cosa succede quando la soglia viene superata:
#   "0" (default)     nessun ban: la sorgente resta droppata solo finché
#                      continua a generare nuovi tentativi nella finestra
#                      sopra (comportamento storico, nessuna dipendenza extra)
#   "<N>m" / "<N>h" / "<N>d"   ban temporaneo (N minuti / ore / giorni):
#                      la sorgente viene aggiunta a una ipset persistente
#                      (sopravvive a un rilancio di firewall-init.sh e,
#                      tramite il salvataggio periodico da cron, anche al
#                      reboot) e scade da sola dopo N
#   "permanent"        ban permanente: resta finché non lo rimuovi a mano
#
# Richiede il pacchetto 'ipset' (installato di default da install.sh). Se
# assente, il ban viene disabilitato con un warning e si torna al
# comportamento storico.
#
# Gestione ban attivi: 'firewall-manager --list-bans' / '--unban <IP>'.
# Esempi: SSH_PROTECT_BAN_DURATION="30m"   SSH_PROTECT_BAN_DURATION="1d"
SSH_PROTECT_BAN_DURATION="0"

# ── Controllo aggiornamenti pacchetto target ─────────────────────────────
# Ogni quanti giorni firewall-manager controlla se è disponibile una
# versione più recente del pacchetto target (confronta il file VERSION
# locale con quello pubblicato su stabile — nessuna chiamata di rete se
# lasciato vuoto/"0", comportamento di default). Il controllo è passivo:
# segnala solo, non installa nulla da solo — l'aggiornamento resta un
# `get-firedog.sh`/update.sh manuale o pianificato separatamente.
#
# Il controllo vero e proprio è agganciato al già esistente export ogni 5
# minuti (`firewall-manager --export-json`, vedi crontab): si auto-limita
# all'intervallo configurato qui, non fa una richiesta di rete ad ogni
# export solo perché è configurato un controllo settimanale.
#
# Esempi: UPDATE_CHECK_INTERVAL_DAYS="7" (settimanale) | "1" (giornaliero)
UPDATE_CHECK_INTERVAL_DAYS="0"

# ── Protezione SYN flood ─────────────────────────────────────────────────
# Rate limit sui nuovi pacchetti SYN in INPUT (qualunque porta): oltre la
# soglia i pacchetti in eccesso vengono droppati. Default alzati (era
# 10/s, burst 20) perché troppo aggressivi per un uso normale con più
# connessioni ravvicinate (SSH, HTTP, tool di test).
SYN_FLOOD_LIMIT_PER_SEC="50"
SYN_FLOOD_BURST="100"
