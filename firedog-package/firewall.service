[Unit]
Description=FireDog Advanced Firewall Service
Documentation=man:iptables(8)
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes

# IMPORTANTE: Non eseguire firewall-init.sh qui!
# firewall-init.sh va eseguito SOLO alla prima installazione da install.sh
# Qui carichiamo le regole salvate per preservare modifiche dinamiche

# Verifica esistenza file regole
ExecStartPre=/bin/bash -c 'test -f /etc/firewall/iptables.rules || { echo "ERRORE: File regole non trovato. Eseguire firewall-init.sh prima."; exit 1; }'

# Carica regole salvate (preserva modifiche dinamiche)
ExecStart=/usr/sbin/iptables-restore /etc/firewall/iptables.rules

# Al reload, salva stato corrente e ricarica
ExecReload=/bin/bash -c '/usr/sbin/iptables-save > /etc/firewall/iptables.rules && /usr/sbin/iptables-restore /etc/firewall/iptables.rules'

# Allo stop, salva stato corrente (NON rimuovere regole per sicurezza)
ExecStop=/usr/sbin/iptables-save -f /etc/firewall/iptables.rules

# Sicurezza del processo
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log /var/lib/firewall /etc/firewall
NoNewPrivileges=false
PrivateTmp=yes

# Timeout
TimeoutStartSec=60s
TimeoutStopSec=10s

# Restart policy
Restart=no

[Install]
WantedBy=multi-user.target
