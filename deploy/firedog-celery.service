# FireDog Celery Worker
# Installazione automatica: deploy/install.sh (sostituisce i placeholder
# __FIREDOG_USER__/__FIREDOG_DIR__). Manuale: vedi INSTALL.md.

[Unit]
Description=FireDog Celery Worker
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=__FIREDOG_USER__
Group=__FIREDOG_USER__
WorkingDirectory=__FIREDOG_DIR__/backend
EnvironmentFile=__FIREDOG_DIR__/backend/.env
ExecStart=__FIREDOG_DIR__/backend/venv/bin/celery -A firedog worker -l info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
