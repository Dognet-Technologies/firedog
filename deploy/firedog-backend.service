# FireDog Backend (Daphne ASGI)
# Installazione:
#   sudo cp deploy/firedog-backend.service /etc/systemd/system/
#   (adatta User/Group/percorsi se il clone non è in /home/microcyber/firedog)
#   sudo systemctl daemon-reload && sudo systemctl enable --now firedog-backend

[Unit]
Description=FireDog Backend (Daphne ASGI)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=microcyber
Group=microcyber
WorkingDirectory=/home/microcyber/firedog/backend
EnvironmentFile=/home/microcyber/firedog/backend/.env
ExecStart=/home/microcyber/firedog/backend/venv/bin/daphne -b 0.0.0.0 -p 8000 firedog.asgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
