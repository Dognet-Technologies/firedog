# FireDog Backend (Daphne ASGI)
# Installazione automatica: deploy/install.sh (sostituisce i placeholder
# __FIREDOG_USER__/__FIREDOG_DIR__ con i valori scelti in fase di install).
# Installazione manuale: copia in /etc/systemd/system/ dopo aver sostituito
# a mano i placeholder, poi `systemctl daemon-reload && enable --now`.

[Unit]
Description=FireDog Backend (Daphne ASGI)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=__FIREDOG_USER__
Group=__FIREDOG_USER__
WorkingDirectory=__FIREDOG_DIR__/backend
EnvironmentFile=__FIREDOG_DIR__/backend/.env
ExecStart=__FIREDOG_DIR__/backend/venv/bin/daphne -b 0.0.0.0 -p 8000 firedog.asgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
