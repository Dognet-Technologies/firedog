			"contents": "/* Discovery Page Styles - Neon/Chronograf Theme */ \n\n.discovery-page {\n  padding: 0;\n  min-height: 100vh;\n}\n\n/* ==================== Header ==================== */\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 30px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--border-primary);\n}\n\n.page-header h1 {\n  margin: 0;\n  font-size: 28px;\n  font-weight: 600;\n  color: var(--text-primary);\n  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.header-info {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.info-badge {\n  padding: 6px 12px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-primary);\n  border-radius: 6px;\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n/* ==================== Tabs ==================== */\n\n.discovery-tabs {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 30px;\n  border-bottom: 2px solid var(--border-primary);\n}\n\n.tab-button {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 12px 20px;\n  background: transparent;\n  border: none;\n  border-bottom: 2px solid transparent;\n  color: var(--text-secondary);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n  margin-bottom: -2px;\n}\n\n.tab-button:hover {\n  color: var(--text-primary);\n  background: var(--bg-secondary);\n}\n\n.tab-button.active {\n  color: var(--accent-primary);\n  border-bottom-color: var(--accent-primary);\n  box-shadow: 0 0 15px rgba(0, 201, 255, 0.3);\n}\n\n.tab-icon {\n  width: 18px;\n  height: 18px;\n  stroke-width: 2;\n}\n\n/* ==================== Tab Content ==================== */\n\n.tab-content {\n  animation: fadeIn 0.3s ease-in;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* ==================== ARP-SCAN ==================== */\n\n.arp-scan-container {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.scan-controls {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  padding: 20px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-primary);\n  border-radius: 8px;\n}\n\n.btn-scan {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.btn-scan svg {\n  width: 20px;\n  height: 20px;\n}\n\n.spinner {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  border: 2px solid rgba(255, 255, 255, 0.3);\n  border-top-color: white;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n.scan-status {\n  padding: 8px 16px;\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.scan-status.status-scanning {\n  background: rgba(0, 201, 255, 0.1);\n  color: var(--accent-primary);\n  border: 1px solid var(--accent-primary);\n}\n\n.scan-status.status-completed {\n  background: rgba(38, 222, 129, 0.1);\n  color: var(--status-success);\n  border: 1px solid var(--status-success);\n}\n\n.scan-status.status-error {\n  background: rgba(255, 71, 87, 0.1);\n  color: var(--status-error);\n  border: 1px solid var(--status-error);\n}\n\n/* ==================== Table Actions ==================== */\n\n.table-actions {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 20px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-primary);\n  border-radius: 8px;\n}\n\n/* ==================== Hosts Table ==================== */\n\n.hosts-table-container {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-primary);\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.hosts-table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.hosts-table thead {\n  background: var(--bg-tertiary);\n  border-bottom: 2px solid var(--border-primary);\n}\n\n.hosts-table th {\n  padding: 12px 16px;\n  text-align: left;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  color: var(--text-secondary);\n  letter-spacing: 0.5px;\n}\n\n.hosts-table td {\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border-primary);\n  font-size: 14px;\n  color: var(--text-primary);\n}\n\n.hosts-table tbody tr {\n  transition: all 0.2s;\n}\n\n.hosts-table tbody tr:hover {\n  background: var(--bg-tertiary);\n}\n\n.hosts-table tbody tr.selected {\n  background: rgba(0, 201, 255, 0.1);\n  border-left: 3px solid var(--accent-primary);\n}\n\n.col-checkbox {\n  width: 40px;\n  text-align: center;\n}\n\n.col-checkbox input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  cursor: pointer;\n}\n\n.col-ip {\n  font-family: 'JetBrains Mono', monospace;\n  color: var(--accent-primary);\n  font-weight: 500;\n}\n\n.col-mac {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n.col-vendor {\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n/* ==================== Badges ==================== */\n\n.badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.badge-success {\n  background: rgba(38, 222, 129, 0.15);\n  color: var(--status-success);\n  border: 1px solid var(--status-success);\n}\n\n.badge-warning {\n  background: rgba(255, 193, 7, 0.15);\n  color: var(--status-warning);\n  border: 1px solid var(--status-warning);\n}\n\n.badge-info {\n  background: rgba(0, 201, 255, 0.15);\n  color: var(--accent-primary);\n  border: 1px solid var(--accent-primary);\n}\n\n/* ==================== Empty State ==================== */\n\n.empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 80px 20px;\n  text-align: center;\n  background: var(--bg-secondary);\n  border: 1px dashed var(--border-primary);\n  border-radius: 8px;\n}\n\n.empty-state svg {\n  width: 64px;\n  height: 64px;\n  stroke: var(--text-tertiary);\n  margin-bottom: 20px;\n  opacity: 0.5;\n}\n\n.empty-state p {\n  margin: 0;\n  font-size: 16px;\n  color: var(--text-secondary);\n}\n\n.empty-subtitle {\n  margin-top: 8px !important;\n  font-size: 14px !important;\n  color: var(--text-tertiary) !important;\n}\n\n/* ==================== FILE IMPORT ==================== */\n\n.file-import-container {\n  max-width: 800px;\n  margin: 0 auto;\n}\n\n.import-card,\n.manual-card {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-primary);\n  border-radius: 8px;\n  padding: 30px;\n}\n\n.import-card h2,\n.manual-card h2 {\n  margin: 0 0 10px 0;\n  font-size: 20px;\n  color: var(--text-primary);\n}\n\n.import-description,\n.manual-description {\n  margin: 0 0 20px 0;\n  font-size: 14px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n.import-description code {\n  padding: 2px 6px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-primary);\n  border-radius: 4px;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 13px;\n  color: var(--accent-primary);\n}\n\n/* File Format Example */\n\n.file-format-example {\n  margin: 20px 0;\n  padding: 20px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-primary);\n  border-radius: 6px;\n}\n\n.file-format-example h3 {\n  margin: 0 0 10px 0;\n  font-size: 14px;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.file-format-example pre {\n  margin: 0;\n  padding: 12px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-primary);\n  border-radius: 4px;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 13px;\n  color: var(--accent-primary);\n  line-height: 1.6;\n  overflow-x: auto;\n}\n\n/* File Input */\n\n.file-input-group {\n  margin: 20px 0;\n}\n\n.file-input {\n  display: none;\n}\n\n.file-label {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 40px;\n  background: var(--bg-tertiary);\n  border: 2px dashed var(--border-primary);\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-size: 14px;\n  color: var(--text-secondary);\n}\n\n.file-label:hover {\n  border-color: var(--accent-primary);\n  background: rgba(0, 201, 255, 0.05);\n  color: var(--accent-primary);\n}\n\n.file-label svg {\n  width: 24px;\n  height: 24px;\n}\n\n/* Import Results */\n\n.import-result {\n  margin-top: 30px;\n  padding: 20px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-primary);\n  border-radius: 6px;\n}\n\n.import-result h3 {\n  margin: 0 0 15px 0;\n  font-size: 16px;\n  color: var(--text-primary);\n}\n\n.result-stats {\n  display: flex;\n  gap: 15px;\n  margin-bottom: 20px;\n}\n\n.stat-item {\n  flex: 1;\n  padding: 15px;\n  border-radius: 6px;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.stat-item.stat-success {\n  background: rgba(38, 222, 129, 0.1);\n  border: 1px solid var(--status-success);\n}\n\n.stat-item.stat-warning {\n  background: rgba(255, 193, 7, 0.1);\n  border: 1px solid var(--status-warning);\n}\n\n.stat-item.stat-error {\n  background: rgba(255, 71, 87, 0.1);\n  border: 1px solid var(--status-error);\n}\n\n.stat-label {\n  font-size: 12px;\n  text-transform: uppercase;\n  color: var(--text-secondary);\n  letter-spacing: 0.5px;\n}\n\n.stat-value {\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--text-primary);\n}\n\n/* Import Errors */\n\n.import-errors {\n  margin-top: 20px;\n}\n\n.import-errors h4 {\n  margin: 0 0 10px 0;\n  font-size: 14px;\n  color: var(--status-error);\n}\n\n.error-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 10px;\n  margin-bottom: 10px;\n  background: rgba(255, 71, 87, 0.05);\n  border-left: 3px solid var(--status-error);\n  border-radius: 4px;\n}\n\n.error-line {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--status-error);\n}\n\n.error-message {\n  font-size: 13px;\n  color: var(--text-primary);\n}\n\n.error-item code {\n  padding: 6px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-primary);\n  border-radius: 4px;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 12px;\n  color: var(--text-tertiary);\n}\n\n/* ==================== MANUAL ADD ==================== */\n\n.manual-add-container {\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.manual-form {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.form-group label {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.input {\n  padding: 10px 14px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-primary);\n  border-radius: 6px;\n  color: var(--text-primary);\n  font-size: 14px;\n  font-family: inherit;\n  transition: all 0.2s;\n}\n\n.input:focus {\n  outline: none;\n  border-color: var(--accent-primary);\n  box-shadow: 0 0 0 3px rgba(0, 201, 255, 0.1);\n}\n\n.input.textarea {\n  resize: vertical;\n  font-family: inherit;\n  line-height: 1.5;\n}\n\n/* ==================== Buttons ==================== */\n\n.btn-primary,\n.btn-secondary {\n  padding: 12px 24px;\n  border: none;\n  border-radius: 6px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));\n  color: white;\n  box-shadow: 0 0 20px rgba(0, 201, 255, 0.3);\n}\n\n.btn-primary:hover:not(:disabled) {\n  box-shadow: 0 0 30px rgba(0, 201, 255, 0.5);\n  transform: translateY(-1px);\n}\n\n.btn-primary:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.btn-secondary {\n  background: var(--bg-tertiary);\n  color: var(--text-primary);\n  border: 1px solid var(--border-primary);\n}\n\n.btn-secondary:hover:not(:disabled) {\n  background: var(--bg-secondary);\n  border-color: var(--accent-primary);\n  color: var(--accent-primary);\n}\n\n/* ==================== Responsive ==================== */\n\n@media (max-width: 768px) {\n  .page-header {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 15px;\n  }\n\n  .discovery-tabs {\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .hosts-table-container {\n    overflow-x: auto;\n  }\n\n  .result-stats {\n    flex-direction: column;\n  }\n\n  .table-actions {\n    flex-direction: column;\n    gap: 10px;\n  }\n}\n\n/* ============================================================================\n   GROUPS TAB - Additional CSS\n   Aggiungi questo al tuo file Discovery.css esistente\n   ============================================================================ */\n\n/* Groups Container Layout */\n.groups-container {\n  padding: 1.5rem;\n}\n\n.groups-layout {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 1.5rem;\n  min-height: 600px;\n}\n\n/* Groups Sidebar */\n.groups-sidebar {\n  background: var(--card-bg, #1a1a2e);\n  border-radius: 8px;\n  padding: 1rem;\n  height: fit-content;\n  position: sticky;\n  top: 1rem;\n}\n\n.sidebar-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.sidebar-header h3 {\n  margin: 0;\n  font-size: 1.1rem;\n  color: var(--text-primary, #fff);\n}\n\n.btn-create-group {\n  background: var(--primary-color, #4CAF50);\n  border: none;\n  border-radius: 6px;\n  padding: 0.5rem;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.btn-create-group svg {\n  width: 16px;\n  height: 16px;\n  stroke: white;\n  stroke-width: 2.5;\n}\n\n.btn-create-group:hover {\n  transform: scale(1.1);\n  box-shadow: 0 0 10px rgba(76, 175, 80, 0.5);\n}\n\n/* Groups List */\n.groups-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.group-item {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  background: rgba(255, 255, 255, 0.03);\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  border: 1px solid transparent;\n}\n\n.group-item:hover {\n  background: rgba(255, 255, 255, 0.06);\n  border-color: rgba(255, 255, 255, 0.1);\n}\n\n.group-item.active {\n  background: var(--primary-color, #4CAF50);\n  background: linear-gradient(135deg, rgba(76, 175, 80, 0.2), rgba(76, 175, 80, 0.1));\n  border-color: var(--primary-color, #4CAF50);\n}\n\n.group-color {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.group-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.group-info h4 {\n  margin: 0 0 0.25rem 0;\n  font-size: 0.9rem;\n  color: var(--text-primary, #fff);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.group-count {\n  font-size: 0.75rem;\n  color: var(--text-secondary, #888);\n}\n\n/* Main Content Area */\n.groups-main {\n  background: var(--card-bg, #1a1a2e);\n  border-radius: 8px;\n  padding: 1.5rem;\n  min-height: 600px;\n}\n\n/* Group Header */\n.group-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 2rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.group-title {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.group-badge {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  flex-shrink: 0;\n}\n\n.group-title h2 {\n  margin: 0 0 0.25rem 0;\n  font-size: 1.5rem;\n  color: var(--text-primary, #fff);\n}\n\n.group-title p {\n  margin: 0;\n  font-size: 0.9rem;\n  color: var(--text-secondary, #888);\n}\n\n.btn-delete {\n  background: rgba(244, 