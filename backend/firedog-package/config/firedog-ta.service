[Unit]
Description=FireDog Firewall Monitoring Service
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/traffic-analyzer --full
StandardOutput=append:/var/log/firedog/analysis.log
StandardError=append:/var/log/firedog/error.log
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
