# FireDog sudoers configuration for microcyber user
# File: /etc/sudoers.d/microcyber
#
# This file grants NOPASSWD sudo permissions to microcyber for FireDog operations
# Install: sudo cp sudoers-microcyber /etc/sudoers.d/microcyber && sudo chmod 440 /etc/sudoers.d/microcyber

# ========== FIREWALL MANAGEMENT ==========
# Allow management of iptables rules without password
microcyber ALL=(ALL) NOPASSWD: /usr/sbin/iptables
microcyber ALL=(ALL) NOPASSWD: /usr/sbin/ip6tables
microcyber ALL=(ALL) NOPASSWD: /usr/sbin/iptables-save
microcyber ALL=(ALL) NOPASSWD: /usr/sbin/iptables-restore

# ========== FIREDOG BINARIES ==========
# Allow execution of FireDog management tools
microcyber ALL=(ALL) NOPASSWD: /usr/local/bin/firewall-manager
microcyber ALL=(ALL) NOPASSWD: /usr/local/bin/traffic-analyzer

# ========== SYSTEMD SERVICE MANAGEMENT ==========
# Allow management of firedog systemd service
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl start firedog
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl stop firedog
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl restart firedog
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl status firedog
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl enable firedog
microcyber ALL=(ALL) NOPASSWD: /bin/systemctl disable firedog

# ========== LOG ACCESS ==========
# Allow reading FireDog logs
microcyber ALL=(ALL) NOPASSWD: /bin/cat /var/log/firedog/*
microcyber ALL=(ALL) NOPASSWD: /bin/cat /opt/firedog/logs/*

# ========== NETWORK ANALYSIS ==========
# Allow network traffic capture and analysis
microcyber ALL=(ALL) NOPASSWD: /usr/sbin/tcpdump
microcyber ALL=(ALL) NOPASSWD: /bin/netstat
microcyber ALL=(ALL) NOPASSWD: /usr/bin/ss

# ========== FILE INTEGRITY ==========
# Allow reading system files for integrity checking
microcyber ALL=(ALL) NOPASSWD: /usr/bin/sha256sum /etc/ssh/sshd_config
microcyber ALL=(ALL) NOPASSWD: /usr/bin/sha256sum /etc/sudoers.d/microcyber
microcyber ALL=(ALL) NOPASSWD: /usr/bin/sha256sum /usr/local/bin/*

# ========== INSTALLATION OPERATIONS ==========
# Needed for initial installation only (can be removed after setup)
microcyber ALL=(ALL) NOPASSWD: /bin/cp /tmp/firedog-package/* /usr/local/bin/
microcyber ALL=(ALL) NOPASSWD: /bin/mkdir -p /opt/firedog/*
microcyber ALL=(ALL) NOPASSWD: /bin/chown -R microcyber\:microcyber /opt/firedog
microcyber ALL=(ALL) NOPASSWD: /bin/chmod * /opt/firedog/*
